# --- Go backend ---
server/bin/
*.test
*.out
coverage.*

# --- Node (web app + docs site) ---
node_modules/
.vite/

# --- Frontend build and test output (also in web/.gitignore) ---
web/dist/
web/coverage/
web/playwright-report/
web/test-results/
web/blob-report/
web/e2e/.auth/
# regenerated on every e2e run; docs keep their own copies in docs/imgs/screenshots/
web/e2e/screenshots/

# --- Docs site (VitePress) ---
docs/.vitepress/dist/
docs/.vitepress/cache/

# --- Node-RED package: dev user dir and packed tarballs ---
integrations/node-red/.dev/
integrations/node-red/dist/
*.tgz

# --- Task runner checksum cache ---
.task/

# --- Local dev / secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
demo-devices.json
fixture.json
*.log

# --- Editors / OS ---
.idea/
*.swp
.DS_Store
docker/mqtt/certs/
